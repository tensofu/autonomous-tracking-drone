<?xml version="1.0"?>
<model>
  <name>flightstack</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>autonomous-tracking-drone</name></author>
  <description>
    Imported CAD part (models/flightstack.STL) - static reference prop in
    the simulation. Mesh units assumed millimetres (bounding box ~251 x
    149 x 322 mm), scaled 0.001 to metres. Collision is a bounding-box
    approximation of the mesh rather than the full 180k-triangle mesh.
  </description>
</model>
